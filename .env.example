# Server-side Netlify Function credentials (use the exact key names below).
TMDB_API_Key=your_own_tmdb_v3_key
TMDB_Read_Access_Token=your_own_tmdb_read_access_token

# Non-secret browser configuration.
VITE_WATCH_REGION=LK
VITE_STREAM_CATALOG_URL=/streams.json

# Optional metadata fallback when the Netlify Function is unavailable.
VITE_OMDB_API_KEY=your_own_omdb_key
